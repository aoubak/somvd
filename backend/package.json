{
  "name": "somvd-backend",
  "version": "1.0.0",
  "description": "Backend API for SOMVD - Social Media Video Downloader",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "install-deps": "npm install",
    "setup": "npm install && npm run install-ytdlp",
    "install-ytdlp": "pip install yt-dlp"
  },
  "keywords": [
    "video-downloader",
    "youtube",
    "tiktok",
    "instagram",
    "facebook",
    "social-media"
  ],
  "author": "SOMVD Team",
  "license": "MIT",
  "dependencies": {
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "morgan": "^1.10.0",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "nodemon": "^3.0.2"
  },
  "engines": {
    "node": ">=16.0.0"
  }
}
